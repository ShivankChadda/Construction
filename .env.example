# Copy to .env and fill in. Never commit .env.

# --- Your server ---
DOMAIN=purchases.example.com
PUBLIC_BASE_URL=https://purchases.example.com
ADMIN_TOKEN=change-me-long-random-string
PRIVACY_CONTACT=            # email or phone shown on https://DOMAIN/privacy (Meta asks for a privacy policy URL)
TIMEZONE=Asia/Kolkata

# --- WhatsApp Cloud API (developers.facebook.com → your app → WhatsApp → API Setup) ---
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=            # permanent System User token, not the 24h test token
WA_APP_SECRET=              # App settings → Basic → App secret (verifies every webhook)
WA_VERIFY_TOKEN=            # any random string; type the same one in the webhook setup
WA_TEMPLATE_NAME=action_required
WA_TEMPLATE_LANG=en

# --- Claude (reads messy lists, photos, Abbas's notes) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium

# --- Sarvam AI (Hindi / Indian-language voice notes) ---
SARVAM_API_KEY=
SARVAM_MODEL=saaras:v4

# --- Signing key for approved slips: run `purchasebot gen-key` ---
SIGNING_KEY=

# --- Google Drive + Sheets (see docs/SETUP.md step 4) ---
GOOGLE_AUTH_MODE=none       # set to oauth after running google-auth
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_DRIVE_ROOT_FOLDER_ID=
GOOGLE_SHEET_ID=

# --- Zoho Books: past purchase rates on the approver's list (read-only; bash scripts/configure.sh sets these) ---
ZOHO_DC=in                  # data centre: in = India
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ORG_ID=
ZOHO_SYNC_DAYS=365          # how far back to read bills
ZOHO_SYNC_HOUR=3            # refresh daily at this hour; -1 disables

# --- Controls ---
CHALLAN_VALID_DAYS=7        # a shop challan is valid this many days after approval
PRICE_ALERT_PCT=5
RECENT_PURCHASE_DAYS=10
APPROVAL_REMINDER_HOURS=4
MAX_APPROVAL_REMINDERS=3
DAILY_DIGEST_HOUR=20
LOGISTICS_TODO_HOUR=8       # morning list for Abbas; -1 disables
FORWARD_BATCH_SECONDS=90    # wait this long after Abbas's last forward, then send one summary
RECEIPT_REMINDER_HOURS=48   # ask the site again if a dispatch isn't confirmed
STALE_REQUIREMENT_DAYS=3
